	<box>true</box> <halign>center</halign>
	<format>!! CANOPY OPEN !!</format>
	<condition>
		<greater-than>
			<property>/instrumentation/doors/crew/position-norm</property><value>0</value>
		</greater-than>
	</condition>
</label>


<halign>left</halign>
</label>

<label>
<name>Ground Speed</name>
<width>1</width>
<height>1</height>
<x>-60</x>
<y>-70</y>
<format>GS:%3dkts</format>
<halign>left</halign>
<input>
<property>/instrumentation/gps/indicated-ground-speed-kt</property>
</input>
</label>


<label>
<width>100</width><height>10</height><x>-100</x><y>-220</y>
<halign>left</halign>
<input><property>/afcs/routeManagerText</property></input>
</label>


<!-- Direction boxes -->
<label><!--wings level -->
<x>-20</x>
<!--<y>-125</y>-->
<y>50</y>
<width>60</width>
<height>6</height>
<box>false</box>
<format>ROLL</format>
<halign>left</halign>
<condition>
<equals>
<property>/autopilot/locks/heading</property>
<value>wing-leveler</value>
</equals>
</condition>
</label>

<label><!--heading hold BUG-->

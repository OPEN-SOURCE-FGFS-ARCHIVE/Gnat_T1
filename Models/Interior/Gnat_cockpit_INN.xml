 <!-- ============================================================== Throttle  (Pilot) -->  
  <animation><type>rotate</type>
    <object-name>barThrottle</object-name>
    <object-name>handleThrottle</object-name>
    <property>/controls/engines/engine/throttle</property>
    <interpolation>
      <entry><ind>  0.0 </ind><dep> -28 </dep></entry>
      <entry><ind>  0.5 </ind><dep>   0 </dep></entry>
       <entry><ind> 1.0 </ind><dep>  22 </dep></entry>     
    </interpolation>
    <axis><object-name>rotationThrottle</object-name></axis>
  </animation>   
    
 <!-- =========================================================== Gear Handle  (Pilot) -->  
  <animation><type>rotate</type>
    <object-name>gearHandle</object-name>
    <property>/controls/gear/gear-down</property>
    <interpolation>
      <entry><ind>  0.0 </ind><dep>  32 </dep></entry>
      <entry><ind>  0.5 </ind><dep>   0 </dep></entry>
       <entry><ind> 1.0 </ind><dep> -32 </dep></entry>     
    </interpolation>
    <axis><object-name>rotationThrottle</object-name></axis>
  </animation>       


 <!-- =========================================================== Gear Handle  (Pilot) -->  
  <animation><type>rotate</type>
    <object-name>brakeHandle</object-name>
    <property>/controls/gear/brake-parking</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>   0 </dep></entry>
      <entry><ind> 0.8 </ind><dep>  -1 </dep></entry>
      <entry><ind> 1.0 </ind><dep> -90 </dep></entry>     
    </interpolation>
    <axis><object-name>rotateBrakeHandle</object-name></axis>
  </animation> 
  
<!-- ====================================================== Park Brake Handle  (Pilot) -->  
  
  <animation>
    <type>translate</type>
    <object-name>brakeHandle</object-name>
    <property>/controls/gear/brake-parking</property>
    <factor>-1</factor>
    <axis><object-name>translateBrakeHandle</object-name></axis>
  </animation>  
  
<!-- ============================================================ Smoke Colour (Pilot) -->  
 <animation>
  <type>pick</type>
   <object-name>knobSmokeRed</object-name>
   <action>
    <button>0</button>
    <repeatable>false</repeatable>
    <interval-sec>0.2</interval-sec>
    <binding>
      <command>nasal</command>
        <script>
          if (getprop("/Gnat_T1/smoke/red") == 0){
            setprop("/Gnat_T1/smoke/red", 1);
            setprop("/Gnat_T1/smoke/white", 0);
            setprop("/Gnat_T1/smoke/blue", 0);
          }
          else{
            setprop("/Gnat_T1/smoke/red", 0);
          }
        </script>    
    </binding>
   </action>
 </animation> 
   <animation>
    <type>rotate</type>
    <object-name>knobSmokeRed</object-name>
    <property>/Gnat_T1/smoke/red</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>-22.5 </dep></entry>
      <entry><ind> 1.0 </ind><dep> 22.5 </dep></entry>     
    </interpolation>
    <axis><object-name>rotateSmokeRed</object-name></axis>
  </animation> 


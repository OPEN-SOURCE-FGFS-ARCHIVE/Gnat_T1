<!-- ================================================================ Magnetic Compass -->
  <animation>
    <type>rotate</type>
    <object-name>compassBall</object-name>
    <property>/instrumentation/magnetic-compass/indicated-heading-deg</property>
    <axis><object-name>rotationHeading</object-name></axis>
  </animation>
  
  <animation>
    <type>rotate</type>
    <object-name>compassBall</object-name>
    <property>/orientation/roll-rate-degps</property>
    <factor>-0.1</factor>
    <axis><object-name>rotationRollRate</object-name></axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>compassBall</object-name>
    <property>/orientation/pitch-rate-degps</property>

  </animation>
   <animation><type>textranslate</type><object-name>gear2_UP</object-name>
    <property>/Gnat_T1/gear2_UP</property><bias>0.0001</bias>
    <factor>0.5</factor><step>1</step><axis><x>1</x><y>0</y></axis><!-- ????????????? -->
